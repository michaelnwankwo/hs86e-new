# =============================================================================
# HS86E Tickets — server-side environment (never prefix secrets with NEXT_PUBLIC_)
# Copy to .env.local and fill in live values. See SETUP_AND_PLUGIN_MANUAL.md §3.4
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true

# Headless WordPress (Deployable B) — required for live tickets
# DEMO_MODE must be false or the PWA keeps showing sample events
WP_BASE_URL=https://your-wordpress-site.com
WC_CONSUMER_KEY=ck_
WC_CONSUMER_SECRET=cs_
WP_APP_USER=hs86e-scanner
WP_APP_PASSWORD=
# Optional: only list this WooCommerce category (default: event-tickets)
WC_CATEGORY_SLUG=event-tickets
# If you have no event-tickets category, set true to list every published product
WC_INCLUDE_ALL_PRODUCTS=false

# Stripe (international cards) — Checkout Session + webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Flutterwave (NGN cards, bank transfer, USSD — Lagos primary)
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
NEXT_PUBLIC_FLW_PUBLIC_KEY=

# Door-staff scanner
# Provide EITHER a bcrypt hash (production) or a plaintext PIN (local/demo only)
SCAN_STAFF_PIN=8686
SCAN_STAFF_PIN_HASH=
SCAN_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# QR token HMAC key. Optional — when unset, SCAN_JWT_SECRET is used so old
# passes stay valid. Set it to separate QR signing from staff sessions (best
# practice). Must be >= 24 chars.
TICKET_HMAC_SECRET=

# WooCommerce product webhook → POST /api/revalidate.
# REQUIRED for the webhook: the endpoint now fails closed (503) until this is
# set, so an attacker cannot spam cache-flush requests.
REVALIDATE_SECRET=

# Optional: restrict scanner to a single flagship event product ID
SCAN_DEFAULT_EVENT_ID=

# Optional: email transferred passes (Resend). Without this, transfers still
# rotate the QR and write .data/outbox — share the pass link instead.
RESEND_API_KEY=
RESEND_FROM=HS86E Tickets <tickets@hotsince86ent.com>
